{
  "name": "video-download-manager",
  "version": "1.0.0",
  "description": "A desktop download manager for videos and playlists, powered by yt-dlp",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.umer.fetch",
    "productName": "Fetch",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": "nsis"
    },
"nsis": {
  "oneClick": false,
  "allowToChangeInstallationDirectory": true,
  "createDesktopShortcut": true,
  "include": "build/installer.nsh"
},
    "win": {
     "target": "nsis",
     "icon": "build/icon.ico"
   }
  }
}
